# Supabase Configuration
# Replace these with your actual Supabase project credentials from Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Company Domain Restriction
# Only users with emails ending in this domain will be permitted to access the application
EXPO_PUBLIC_ALLOWED_DOMAIN=hbplus.fit
